# =================================================================
# FreightTiger Smart Shipping Cost Assistant - Environment Configuration
# =================================================================

# AI / LLM Configuration
# By default, uses the built-in local deterministic RAG reasoner.
# Requires NO API key, zero costs, and achieves 100% reproducible results.
LLM_PROVIDER=local_deterministic
LLM_MODEL=local-guardrail-v1

# Optional: Cloud LLM providers (e.g. OpenAI, Groq, Ollama)
# If using OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here

# If using Groq:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1

# If using local Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# Temperature must be 0.0 for strict reproducibility
LLM_TEMPERATURE=0.0

# Anomaly Detection Thresholds (%)
OWN_HISTORY_THRESHOLD_PCT=20.0
SIMILAR_ROUTES_THRESHOLD_PCT=20.0
TRAILING_WEEKS_WINDOW=8

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=.chroma_db
CHROMA_COLLECTION_NAME=freight_context_notes
